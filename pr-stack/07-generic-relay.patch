+++ b/tests/waku_relay/test_pubsub_mock.nim
@@ -0,0 +1,156 @@
+{.used.}
+
+## Runs the relay on a backend that is not nim-libp2p: any type satisfying the
+## `IPubSub` concept can back `WakuRelayOf`.
+
+import
+  std/[tables, sequtils, sets],
+  results,
+  testutils/unittests,
+  chronos,
+  chronicles,
+  metrics
+
+import
+  logos_delivery/waku/waku_core,
+  logos_delivery/waku/waku_relay/protocol,
+  logos_delivery/waku/libp2p_iface/pubsub,
+  ../testlib/wakucore
+
+type MockPubSub = ref object
+  selfId: PeerIdStr
+  handlers: Table[string, PubSubHandler]
+  validators: Table[string, PubSubValidator]
+  eventHandler: PubSubEventHandler
+  scoreTopics: HashSet[string]
+  started: bool
+
+proc new(T: type MockPubSub): MockPubSub =
+  MockPubSub(selfId: "mock-peer-id-0000000000")
+
+proc start(m: MockPubSub): Future[void] {.async: (raises: [CancelledError]).} =
+  m.started = true
+
+proc stop(m: MockPubSub): Future[void] {.async: (raises: []).} =
+  m.started = false
+
+proc subscribe(m: MockPubSub, topic: string, handler: PubSubHandler) =
+  m.handlers[topic] = handler
+
+proc unsubscribe(m: MockPubSub, topic: string) =
+  m.handlers.del(topic)
+
+proc unsubscribeAll(m: MockPubSub, topic: string) =
+  m.handlers.del(topic)
+
+proc addValidator(m: MockPubSub, topic: string, validator: PubSubValidator) =
+  m.validators[topic] = validator
+
+proc removeValidator(m: MockPubSub, topic: string) =
+  m.validators.del(topic)
+
+proc setTopicScoreParams(m: MockPubSub, topic: string, params: TopicScoreParams) =
+  m.scoreTopics.incl(topic)
+
+proc topics(m: MockPubSub): seq[string] =
+  toSeq(m.handlers.keys)
+
+proc meshPeers(m: MockPubSub, topic: string): Result[seq[PubSubPeerInfo], string] =
+  ok(@[PubSubPeerInfo(peerId: "remote-peer-id", score: 1.0)])
+
+proc connectedPeers(m: MockPubSub, topic: string): Result[seq[PubSubPeerInfo], string] =
+  ok(@[PubSubPeerInfo(peerId: "remote-peer-id", score: 1.0)])
+
+proc params(m: MockPubSub): PubSubParams =
+  PubSubParams(d: 6, dLow: 4, dHigh: 8)
+
+proc selfPeerId(m: MockPubSub): PeerIdStr =
+  m.selfId
+
+proc setEventHandler(m: MockPubSub, handler: PubSubEventHandler) =
+  m.eventHandler = handler
+
+proc setTriggerSelf(m: MockPubSub, value: bool) =
+  discard
+
+proc enablePeerExchange(m: MockPubSub, handler: PubSubPeerExchangeHandler) =
+  discard
+
+proc publish(m: MockPubSub, topic: string, data: seq[byte]): Future[int] {.async.} =
+  ## Loops the message back to our own subscription, as a real backend would
+  ## with triggerSelf enabled.
+  let validator = m.validators.getOrDefault(topic)
+  if not validator.isNil():
+    if (await validator(topic, data)) != ValidationResult.Accept:
+      return 0
+  let handler = m.handlers.getOrDefault(topic)
+  if not handler.isNil():
+    await handler(topic, data)
+  return 1
+
+static:
+  doAssert MockPubSub is IPubSub
+
+suite "Waku Relay - mock pubsub backend":
+  asyncTest "published messages reach the subscription handler":
+    let backend = MockPubSub.new()
+    let relay = WakuRelayOf[MockPubSub].new(backend).tryGet()
+    await relay.start()
+
+    var received: seq[WakuMessage]
+    proc handler(topic: PubsubTopic, msg: WakuMessage): Future[void] {.async, gcsafe.} =
+      received.add(msg)
+
+    relay.subscribe(DefaultPubsubTopic, handler)
+
+    let msg = fakeWakuMessage(contentTopic = "/mock/1/chat/proto")
+    let published = await relay.publish(DefaultPubsubTopic, msg)
+
+    check:
+      published.isOk()
+      published.get() == 1
+      received.len == 1
+      received[0].contentTopic == msg.contentTopic
+      relay.isSubscribed(DefaultPubsubTopic)
+      relay.getSubscribedTopics() == @[DefaultPubsubTopic]
+      relay.getNumPeersInMesh(DefaultPubsubTopic).get() == 1
+      DefaultPubsubTopic in backend.scoreTopics
+
+    await relay.stop()
+
+  asyncTest "a rejecting waku validator keeps the message from the handler":
+    let backend = MockPubSub.new()
+    let relay = WakuRelayOf[MockPubSub].new(backend).tryGet()
+
+    relay.addValidator(
+      proc(topic: PubsubTopic, msg: WakuMessage): Future[ValidationResult] {.async.} =
+        return ValidationResult.Reject,
+      "always reject",
+    )
+
+    var received = 0
+    proc handler(topic: PubsubTopic, msg: WakuMessage): Future[void] {.async, gcsafe.} =
+      inc received
+
+    relay.subscribe(DefaultPubsubTopic, handler)
+
+    let published = await relay.publish(DefaultPubsubTopic, fakeWakuMessage())
+
+    check:
+      published.isErr()
+      received == 0
+
+  asyncTest "unsubscribing drops the subscription":
+    let backend = MockPubSub.new()
+    let relay = WakuRelayOf[MockPubSub].new(backend).tryGet()
+
+    proc handler(topic: PubsubTopic, msg: WakuMessage): Future[void] {.async, gcsafe.} =
+      discard
+
+    relay.subscribe(DefaultPubsubTopic, handler)
+    check relay.isSubscribed(DefaultPubsubTopic)
+
+    relay.unsubscribe(DefaultPubsubTopic)
+    check:
+      not relay.isSubscribed(DefaultPubsubTopic)
+      backend.validators.len == 0

[submodule "vendor/zerokit"]
	path = vendor/zerokit
	url = https://github.com/vacp2p/zerokit.git
	ignore = dirty
	branch = release-v2.0.1
[submodule "vendor/waku-rlnv2-contract"]
	path = vendor/waku-rlnv2-contract
